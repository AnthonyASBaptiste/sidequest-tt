{
  "name": "sidequest-tt-backend",
  "version": "0.1.0",
  "description": "SideQuest T&T NestJS API foundation",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node --env-file=.env dist/main.js",
    "db:check": "npm run build && node --env-file=.env dist/check-database.js",
    "db:seed": "npm run build && node dist/seed-sample-data.js",
    "worker:verify": "node --env-file=worker/.env worker/verify-worker.mjs",
    "worker:generate-pool": "node --env-file=worker/.env worker/generate-quest-pool.mjs",
    "worker:generate-pool:schedule": "node --env-file=worker/.env worker/generate-quest-pool.mjs --schedule",
    "worker:all": "node worker/run-all-workers.mjs",
    "worker:daemon": "node worker/run-all-workers.mjs"
  },
  "dependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/swagger": "^11.4.7",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "exifreader": "^4.50.0",
    "mongoose": "^9.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "js-yaml": "^5.4.3"
  }
}
