# SideQuest T&T API configuration
# Point to your deployed Render API (or http://localhost:3000 for local dev)
API_BASE_URL="https://sidequest-tt.onrender.com"

# The shared worker bearer credential (must match the API's VERIFICATION_WORKER_SECRET, min 32 chars)
VERIFICATION_WORKER_SECRET="<insert-your-worker-secret-here>"

# Worker claim lease duration in seconds (must match API setting, default 120)
VERIFICATION_LEASE_SECONDS=120

# NVIDIA NIM API Configuration (Gemma 2 27B)
# Add your NVIDIA API key (nvapi-...) to use cloud-accelerated Gemma 2 27B
NVIDIA_API_KEY="<insert-your-nvidia-api-key-here>"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
GEMMA_MODEL="google/gemma-2-27b-it"

# Worker polling and timeout settings (milliseconds)
WORKER_POLL_INTERVAL_MS=5000
WORKER_API_TIMEOUT_MS=10000
WORKER_MODEL_TIMEOUT_MS=75000

# Optional legacy local Ollama configuration (active only if NVIDIA_API_KEY is omitted)
# GEMMA_BASE_URL="http://localhost:11434"
# GEMMA_MODEL="gemma4:e2b-it-qat"
